 &EXF_NML_01
 exf_iprec         = 32,
 exf_iprec_obcs    = 32,
 exf_yftype        = 'RL',
 useExfYearlyFields= .TRUE.,
 useExfCheckRange  = .FALSE.,
 useRelativeWind   = .TRUE.,
 exf_albedo        = 0.15,
 exf_scal_BulkCdn  = 1.015,
 cstanton_1        = 0.035,
 cstanton_2        = 0.02,
 cdalton           = 0.035,
 useKatabCorr=.true.,
 katabSclFile='katabatic_scale_PAS_90W',
 katabRtFile='katabatic_rotate_PAS_90W',
 /

